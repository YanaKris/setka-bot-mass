# Скопировать в .env: cp .env.example .env
# Полный список переменных и их смысл — wiki §8.

# БД и брокер появятся в волне 4 (#5, #11); до этого значения не используются, но обязательны для старта.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/setka
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Адрес API «Сетки». В dev — мок из docker-compose (#6), в бою — https://api.setka.ru (wiki §7.1).
# При запуске api на хосте, а не в compose: http://localhost:8001
SETKA_API_BASE_URL=http://setka-mock:8001

# Каталог для загруженных PDF; в compose это именованный том uploads.
UPLOADS_DIR=/data/uploads

# Отправка: число повторов при ошибке «Сетки» (T12) и пауза между отправками в секундах — троттлинг (T10).
SEND_MAX_RETRIES=5
SEND_DELAY_SECONDS=1
